# News sources (at least one is required; Finnhub also gives prices and custom tickers)
FINNHUB_API_KEY=
GNEWS_API_KEY=
NEWS_API_KEY=

# Optional: Hugging Face token to score with FinBERT instead of VADER
HF_API_TOKEN=

# Optional: Postgres for caching and daily history (Neon works well with Vercel)
DATABASE_URL=

# Optional tuning
CACHE_MINUTES=120
RATE_LIMIT_PER_MINUTE=8
